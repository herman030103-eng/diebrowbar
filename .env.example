# ====================
# НАСТРОЙКИ ПОЧТЫ / EMAIL SETTINGS
# ====================

# Выберите провайдера: gmail, yandex, outlook
EMAIL_PROVIDER=gmail

# Gmail настройки
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
GMAIL_IMAP_SERVER=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_SMTP_SERVER=smtp.gmail.com
GMAIL_SMTP_PORT=587

# Yandex настройки (альтернатива)
# EMAIL_ADDRESS=your_email@yandex.ru
# EMAIL_PASSWORD=your_password
# YANDEX_IMAP_SERVER=imap.yandex.ru
# YANDEX_IMAP_PORT=993
# YANDEX_SMTP_SERVER=smtp.yandex.ru
# YANDEX_SMTP_PORT=587

# Outlook настройки (альтернатива)
# EMAIL_ADDRESS=your_email@outlook.com
# EMAIL_PASSWORD=your_password
# OUTLOOK_IMAP_SERVER=outlook.office365.com
# OUTLOOK_IMAP_PORT=993
# OUTLOOK_SMTP_SERVER=smtp.office365.com
# OUTLOOK_SMTP_PORT=587

# ====================
# LLM НАСТРОЙКИ / LLM SETTINGS
# ====================

# Выберите LLM провайдера: openai, anthropic, perplexity, ollama, huggingface
LLM_PROVIDER=ollama

# OpenAI настройки (платный)
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4-turbo-preview
# OPENAI_MAX_TOKENS=1000
# OPENAI_TEMPERATURE=0.3

# Anthropic Claude настройки (платный)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# ANTHROPIC_MODEL=claude-3-sonnet-20240229
# ANTHROPIC_MAX_TOKENS=1000

# Perplexity настройки (платный, но у вас есть доступ)
# PERPLEXITY_API_KEY=pplx-your-api-key-here
# PERPLEXITY_MODEL=llama-3.1-sonar-small-128k-online
# PERPLEXITY_MAX_TOKENS=1000
# PERPLEXITY_TEMPERATURE=0.3

# Ollama настройки (БЕСПЛАТНО - локальный)
# Установите Ollama: https://ollama.ai
# Запустите модель: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_MAX_TOKENS=1000
OLLAMA_TEMPERATURE=0.3

# Hugging Face настройки (БЕСПЛАТНО с ограничениями)
# Получите токен: https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=hf_your_token_here
# HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.2
# HUGGINGFACE_MAX_TOKENS=1000

# ====================
# TELEGRAM BOT НАСТРОЙКИ / TELEGRAM BOT SETTINGS
# ====================

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Получите токен бота у @BotFather в Telegram
# Получите Chat ID у @userinfobot в Telegram

# ====================
# НАСТРОЙКИ АГЕНТА / AGENT SETTINGS
# ====================

# Интервал проверки почты (в минутах)
CHECK_INTERVAL_MINUTES=5

# Максимальное количество писем для обработки за раз
MAX_EMAILS_PER_CHECK=50

# Включить автоматическое удаление (true/false)
ENABLE_AUTO_DELETE=false

# Включить автоматическую архивацию (true/false)
ENABLE_AUTO_ARCHIVE=true

# ====================
# БАЗА ДАННЫХ / DATABASE
# ====================

DATABASE_PATH=data/email_agent.db

# ====================
# ЛОГИРОВАНИЕ / LOGGING
# ====================

LOG_LEVEL=INFO
LOG_FILE=logs/email_agent.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ====================
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ / ADDITIONAL SETTINGS
# ====================

# Язык интерфейса: ru, en
LANGUAGE=ru

# Таймзона
TIMEZONE=Europe/Moscow
